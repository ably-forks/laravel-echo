{
    // Type-checks upstream @laravel/echo-vue 2.x usage (upstream-usage.ts, via the `@laravel/echo-vue` mapping)
    // and the fork's additions (fork-usage.ts, via the package's own `exports`) against the built declarations.
    // Build first.
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2022", "dom"],
        "types": ["node"],
        "skipLibCheck": false,
        "paths": {
            "@laravel/echo-vue": ["../../dist/index.d.ts"]
        }
    },
    "files": ["upstream-usage.ts", "fork-usage.ts"]
}
