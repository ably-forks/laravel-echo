{
    "name": "@ably/laravel-echo-vue",
    "version": "2.0.0",
    "description": "Vue composables for @ably/laravel-echo.",
    "keywords": [
        "laravel",
        "pusher",
        "ably",
        "vue"
    ],
    "homepage": "https://github.com/ably-forks/laravel-echo/tree/2.x/packages/vue",
    "repository": {
        "type": "git",
        "url": "https://github.com/ably-forks/laravel-echo",
        "directory": "packages/vue"
    },
    "license": "MIT",
    "author": {
        "name": "Taylor Otwell"
    },
    "type": "module",
    "main": "dist/index.common.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "vp build && FORMAT=iife vp build && tsc -p tsconfig.build.json",
        "dev": "vp dev",
        "test": "vp test"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^30.0.0",
        "@ably/laravel-echo": "workspace:^",
        "pusher-js": "^8.4.0",
        "socket.io-client": "^4.8.1",
        "typescript": "catalog:",
        "vite-plus": "catalog:",
        "vue": "^3.5.41"
    },
    "peerDependencies": {
        "@ably/laravel-echo": "^2.0.0-rc.0",
        "pusher-js": "*",
        "socket.io-client": "*",
        "vue": "^3.0.0"
    },
    "peerDependenciesMeta": {
        "pusher-js": {
            "optional": true
        },
        "socket.io-client": {
            "optional": true
        }
    },
    "typesVersions": {
        "*": {
            "socket.io-client": [],
            "pusher-js": []
        }
    },
    "engines": {
        "node": ">=22"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.common.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
