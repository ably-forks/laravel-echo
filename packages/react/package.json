{
    "name": "@ably/laravel-echo-react",
    "version": "2.0.0",
    "description": "React hooks for @ably/laravel-echo.",
    "keywords": [
        "laravel",
        "pusher",
        "ably",
        "react"
    ],
    "homepage": "https://github.com/ably-forks/laravel-echo/tree/2.x/packages/react",
    "repository": {
        "type": "git",
        "url": "https://github.com/ably-forks/laravel-echo",
        "directory": "packages/react"
    },
    "license": "MIT",
    "author": {
        "name": "Taylor Otwell"
    },
    "type": "module",
    "main": "dist/index.common.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "vp build && FORMAT=iife vp build && tsc -p tsconfig.build.json",
        "dev": "vp dev",
        "test": "vp test --project unit",
        "test:bundles": "vp test --run --project bundles",
        "test:compat": "tsc -p tests/compat/tsconfig.json"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^24.13.3",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.3",
        "jsdom": "^30.0.0",
        "@ably/laravel-echo": "workspace:^",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "typescript": "catalog:",
        "vite-plus": "catalog:"
    },
    "peerDependencies": {
        "@ably/laravel-echo": "^2.0.0-rc.0",
        "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "engines": {
        "node": ">=22"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "react-native": "./dist/index.common.js",
            "import": "./dist/index.js",
            "require": "./dist/index.common.cjs"
        },
        "./iife": "./dist/echo-react.iife.js"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
