{
    // Type-checks upstream laravel-echo 2.x usage against the built declarations (run `pnpm run build` first).
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2022", "dom"],
        "types": [],
        "skipLibCheck": true,
        "paths": {
            "laravel-echo": ["../../dist/echo.d.ts"],
            "laravel-echo/dist/connector": ["../../dist/connector/index.d.ts"]
        }
    },
    "files": ["upstream-usage.ts"]
}
