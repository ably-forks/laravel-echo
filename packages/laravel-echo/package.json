{
    "name": "@ably/laravel-echo",
    "version": "2.0.0",
    "description": "Laravel Echo library for beautiful Ably integration",
    "keywords": [
        "laravel",
        "ably",
        "pusher",
        "mercure"
    ],
    "homepage": "https://github.com/ably-forks/laravel-echo/tree/2.x/packages/laravel-echo",
    "repository": {
        "type": "git",
        "url": "https://github.com/ably-forks/laravel-echo",
        "directory": "packages/laravel-echo"
    },
    "license": "MIT",
    "author": {
        "name": "Taylor Otwell"
    },
    "type": "module",
    "main": "dist/echo.common.cjs",
    "module": "dist/echo.js",
    "types": "dist/echo.d.ts",
    "scripts": {
        "build": "vp build && FORMAT=iife vp build && tsc -p tsconfig.build.json",
        "build:js": "vp build && FORMAT=iife vp build",
        "dev": "vp dev",
        "test": "vp test --run --project unit --project ably",
        "test:sandbox": "vp test --run --project sandbox",
        "test:browser-build": "vp test --run --project browser-build",
        "test:bundles": "vp test --run --project bundles",
        "test:all": "vp test --run"
    },
    "devDependencies": {
        "@ably/pubsub-server": "^3.0.0",
        "@types/jquery": "^3.5.32",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^24.13.3",
        "axios": "^1.18.0",
        "jsdom": "^30.0.0",
        "jsonwebtoken": "^9.0.2",
        "pusher-js": "^8.4.0",
        "socket.io-client": "^4.8.3",
        "typescript": "catalog:",
        "vite-plus": "catalog:",
        "wait-for-expect": "^3.0.2"
    },
    "peerDependencies": {
        "pusher-js": "*",
        "socket.io-client": "*"
    },
    "peerDependenciesMeta": {
        "pusher-js": {
            "optional": true
        },
        "socket.io-client": {
            "optional": true
        }
    },
    "typesVersions": {
        "*": {
            "socket.io-client": [],
            "pusher-js": []
        }
    },
    "engines": {
        "node": ">=22"
    },
    "exports": {
        ".": {
            "types": "./dist/echo.d.ts",
            "import": "./dist/echo.js",
            "require": "./dist/echo.common.cjs"
        },
        "./iife": "./dist/echo.iife.js"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "dependencies": {
        "@ably/pubsub-device": "^3.0.0"
    }
}
