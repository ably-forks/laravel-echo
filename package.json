{
    "name": "ably-laravel-echo-monorepo",
    "private": true,
    "description": "Laravel Echo with the native Ably connector (monorepo for @ably/laravel-echo and the React, Vue and Svelte adapters)",
    "homepage": "https://github.com/ably-forks/laravel-echo",
    "repository": {
        "type": "git",
        "url": "https://github.com/ably-forks/laravel-echo"
    },
    "license": "MIT",
    "author": {
        "name": "Taylor Otwell"
    },
    "packageManager": "pnpm@12.3.4",
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
    },
    "scripts": {
        "test": "pnpm -r --parallel --no-sort --if-present run test",
        "build": "pnpm -r --if-present run build",
        "lint": "vp lint",
        "format": "vp fmt",
        "compile": "pnpm -r --if-present run compile",
        "declarations": "pnpm -r --if-present run declarations",
        "dev": "pnpm -r --parallel --filter './packages/*' dev"
    },
    "devDependencies": {
        "vite-plus": "catalog:"
    }
}
